{
  "name": "@camircode/twofree-data-provider",
  "version": "0.1.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./in-memory-provider.js": {
      "types": "./dist/in-memory-provider.d.ts",
      "default": "./dist/in-memory-provider.js"
    },
    "./portability.js": {
      "types": "./dist/portability.d.ts",
      "default": "./dist/portability.js"
    },
    "./provider.js": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@camircode/twofree-core": "workspace:*",
