  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-static.mjs src dist .sql",
    "test": "vitest run --config vitest.config.ts"
